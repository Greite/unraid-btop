<?php
/* btop tile settings. Values are written to /boot/config/plugins/btop/btop.cfg
   by Unraid's native /update.php endpoint (session-authenticated). */
require_once '/usr/local/emhttp/plugins/btop/include/stats_lib.php';
$btop_cfg = btop_read_cfg();

function btop_sel($current, $value): string {
    return $current === $value ? ' selected' : '';
}
?>
<form markdown="1" id="btopSettingsForm" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="btop/btop.cfg">

<div class="title"><span class="left"><i class="fa fa-header"></i>_(Tile header)_</span></div>

_(Show load average)_:
: <select name="SHOW_LOAD"><option value="yes"<?=btop_sel($btop_cfg['SHOW_LOAD'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_LOAD'], 'no')?>>_(No)_</option></select>

:btop_show_load_plug:
> Shows the 1, 5 and 15 minute load averages in the tile header.
:end

_(Show CPU temperature)_:
: <select name="SHOW_TEMP"><option value="yes"<?=btop_sel($btop_cfg['SHOW_TEMP'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_TEMP'], 'no')?>>_(No)_</option></select>

:btop_show_temp_plug:
> Shows the CPU package temperature in the tile header, read from the motherboard sensors (coretemp, k10temp, zenpower). Hidden automatically if no known sensor is found.
:end

_(Show uptime)_:
: <select name="SHOW_UPTIME"><option value="yes"<?=btop_sel($btop_cfg['SHOW_UPTIME'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_UPTIME'], 'no')?>>_(No)_</option></select>

:btop_show_uptime_plug:
> Shows the system uptime in the tile header.
:end

_(Show process count)_:
: <select name="SHOW_NPROCS"><option value="yes"<?=btop_sel($btop_cfg['SHOW_NPROCS'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_NPROCS'], 'no')?>>_(No)_</option></select>

:btop_show_nprocs_plug:
> Shows the total number of running processes in the tile header.
:end

<div class="title"><span class="left"><i class="fa fa-exchange"></i>_(Disk and network throughput)_</span></div>

_(Show aggregated disk I/O rates)_:
: <select name="SHOW_DISKIO"><option value="yes"<?=btop_sel($btop_cfg['SHOW_DISKIO'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_DISKIO'], 'no')?>>_(No)_</option></select>

:btop_show_diskio_plug:
> Shows the read/write throughput, averaged over the refresh interval and summed over all physical disks (sdX, nvme). Partitions and array (md) devices are excluded so nothing is counted twice.
:end

_(Show aggregated network rates)_:
: <select name="SHOW_NET"><option value="yes"<?=btop_sel($btop_cfg['SHOW_NET'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_NET'], 'no')?>>_(No)_</option></select>

:btop_show_net_plug:
> Shows the download/upload throughput, averaged over the refresh interval and summed over the physical network interfaces. Bridges and bonds are excluded so traffic is not counted twice.
:end

<div class="title"><span class="left"><i class="fa fa-tasks"></i>_(Process table)_</span></div>

_(Show process table)_:
: <select name="SHOW_PROCS"><option value="yes"<?=btop_sel($btop_cfg['SHOW_PROCS'], 'yes')?>>_(Yes)_</option><option value="no"<?=btop_sel($btop_cfg['SHOW_PROCS'], 'no')?>>_(No)_</option></select>

:btop_show_procs_plug:
> Shows the table of the busiest processes, with their CPU usage over the last refresh interval and memory footprint (RSS).
:end

_(Label processes with)_:
: <select name="PROC_NAMES"><option value="process"<?=btop_sel($btop_cfg['PROC_NAMES'], 'process')?>>_(Process name)_</option><option value="container"<?=btop_sel($btop_cfg['PROC_NAMES'], 'container')?>>_(Docker container / VM name)_</option></select>

:btop_proc_names_plug:
> Labels each row of the process table with the process name, or with the name of the Docker container or virtual machine the process belongs to. Processes matching neither keep their process name; hovering a row always shows both.
:end

_(Sort processes by)_:
: <select name="PROC_SORT"><option value="cpu"<?=btop_sel($btop_cfg['PROC_SORT'], 'cpu')?>>_(CPU)_</option><option value="mem"<?=btop_sel($btop_cfg['PROC_SORT'], 'mem')?>>_(Memory)_</option></select>

:btop_proc_sort_plug:
> Sorts the process table by CPU usage or by memory usage (RSS).
:end

_(Number of processes shown)_:
: <select name="PROC_COUNT"><?php for ($i = 3; $i <= 10; $i++) echo '<option value="' . $i . '"' . btop_sel($btop_cfg['PROC_COUNT'], $i) . '>' . $i . '</option>'; ?></select>

:btop_proc_count_plug:
> Number of rows in the process table (3 to 10).
:end

<div class="title"><span class="left"><i class="fa fa-clock-o"></i>_(Refresh)_</span></div>

_(Tile refresh interval)_:
: <select name="REFRESH_MS"><?php foreach ([2000 => '2 s', 3000 => '3 s', 5000 => '5 s', 10000 => '10 s'] as $ms => $label) echo '<option value="' . $ms . '"' . btop_sel($btop_cfg['REFRESH_MS'], $ms) . '>' . $label . '</option>'; ?></select>

:btop_refresh_ms_plug:
> How often the tile refreshes its data. Shorter intervals give a more reactive view at the cost of slightly more sampling work on the server.
:end

&nbsp;
: <span class="inline-block">
  <input type="submit" name="#apply" value="_(Apply)_">
  <input type="button" value="_(Done)_" onclick="done()">
  </span>
</form>
<script>
(function () {
  var form = document.getElementById('btopSettingsForm');
  if (!form) return;
  var procsSel = form.elements['SHOW_PROCS'];
  var dependents = [form.elements['PROC_NAMES'], form.elements['PROC_SORT'], form.elements['PROC_COUNT']];
  function syncProcFields() {
    for (var i = 0; i < dependents.length; i++) dependents[i].disabled = procsSel.value === 'no';
  }
  procsSel.addEventListener('change', syncProcFields);
  form.addEventListener('submit', function () {
    // Disabled controls are not submitted: re-enable them so /update.php keeps
    // their values, then restore the disabled state once the form serialized
    for (var i = 0; i < dependents.length; i++) dependents[i].disabled = false;
    setTimeout(syncProcFields, 0);
  });
  syncProcFields();
})();
</script>
