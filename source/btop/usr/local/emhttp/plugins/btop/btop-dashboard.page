Menu="Dashboard:0"
Icon="btop.png"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.0','>=')"
---
<?php
/* btop dashboard tile. Sections are enabled/disabled from the settings page
   (Settings > User Utilities > btop). Content is rendered client-side by
   scripts/btop-tile.js polling include/stats.php. */
require_once '/usr/local/emhttp/plugins/btop/include/stats_lib.php';
$btop_cfg = btop_read_cfg();

$btop_header = '';
if ($btop_cfg['SHOW_LOAD'] === 'yes') $btop_header .= '<span id="btop-load">_(Loading)_&hellip;</span>';
if ($btop_cfg['SHOW_TEMP'] === 'yes') $btop_header .= '<span id="btop-temp"></span>';
if ($btop_cfg['SHOW_UPTIME'] === 'yes' || $btop_cfg['SHOW_NPROCS'] === 'yes') $btop_header .= '<span id="btop-uptime"></span>';

$btop_rates = ($btop_cfg['SHOW_DISKIO'] === 'yes' || $btop_cfg['SHOW_NET'] === 'yes')
    ? '<tr><td><div id="btop-rates"></div></td></tr>' : '';

$btop_procs = $btop_cfg['SHOW_PROCS'] === 'yes'
    ? '<tr class="header"><td><span class="w44">_(Process)_</span><span class="w18">_(CPU)_</span><span class="w18">_(Memory)_</span></td></tr><tr><td><div id="btop-procs"></div></td></tr>'
    : '';

$mytiles['btop']['column1'] = <<<EOT
<tbody id="tblBtopDash" title="_(btop system monitor)_">
<tr>
  <td>
    <span class="tile-header">
      <span class="tile-header-left">
        <img src="/plugins/btop/images/btop.png" alt="" style="width:32px;height:32px">
        <div class="section">_(btop)_<br>
          $btop_header
        </div>
      </span>
      <span class="tile-header-right">
        <span class="tile-header-right-controls">
          <a href="/Settings/SettingsBtop" title="_(btop tile settings)_" aria-label="_(btop tile settings)_">
            <i class="fa fa-fw fa-cog control" aria-hidden="true"></i>
          </a>
        </span>
      </span>
    </span>
  </td>
</tr>
$btop_rates
$btop_procs
</tbody>
EOT;
?>
<style>
/* tabular figures: values keep the same width between refreshes, no jitter */
#btop-load,#btop-temp,#btop-uptime,#btop-rates,#btop-procs{font-variant-numeric:tabular-nums}
/* braille history sparklines (rendered by btop-tile.js), btop's own idiom */
#btop-rates .btop-spark{opacity:.75;margin-right:.4em}
#btop-rates .btop-rate-group+.btop-rate-group{margin-left:1.2em}
/* Long process names (full argv0/cmdline) would stretch the name column past
   the tile itself in Unraid's auto-layout tile table (issue #1). A resolved
   max-width caps that intrinsic width so the column stays put and the overflow
   ellipsizes; the full name lives on in the row's title tooltip. Scoped to the
   whole tile so the header label and the rows keep the same column width. */
#tblBtopDash .w44{display:inline-block;max-width:22ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom}
/* CPU temperature thresholds; colors legible on light and dark themes */
#btop-temp.btop-temp-warn{color:#e07b00}
#btop-temp.btop-temp-hot{color:#d32f2f}
</style>
<script>
window.btopTileText = {
  load: "_(Load)_",
  na: "_(n/a)_",
  up: "_(Up)_",
  procs: "_(procs)_",
  disk: "_(Disk)_",
  net: "_(Net)_",
  statsUnavailable: "_(Stats unavailable)_"
};
</script>
<script src="/plugins/btop/scripts/btop-tile.js"></script>
